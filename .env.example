# Set these only in the hosting service's secret/environment settings or local .env.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=1547213788842037310
DISCORD_GUILD_ID=1547211374726225940
ODDS_API_KEY=
OPENAI_API_KEY=
# Choose a Responses-compatible model enabled for your API project.
OPENAI_MODEL=
# Publisher-filtered research used automatically by /analyze; SportsDataIO is optional.
ANALYSIS_RESEARCH_MODEL=gpt-5-mini
SPORTSDATA_API_KEY=
# Optional per-league keys override SPORTSDATA_API_KEY.
SPORTSDATA_NFL_KEY=
SPORTSDATA_CFB_KEY=
SPORTSDATA_CBB_KEY=
SPORTSDATA_MLB_KEY=
# Explicit season identifiers; update each season. CBB convention is ending year.
NFL_SEASON=2026
CFB_SEASON=2026
CBB_SEASON=2027
MLB_SEASON=2026
# Trial data can be scrambled. Set true only after enabling production data.
SPORTSDATA_PRODUCTION=false
DATABASE_PATH=./data/flea.sqlite
# Scheduled posts default OFF. Enable per sport with /feed after reviewing setup.
AI_DAILY_LIMIT=40
ODDS_DAILY_LIMIT=120

# Allow same-game props in suggested tickets (no combined price if enabled)
ALLOW_CORRELATED_PROPS=false

# Screenshot extraction (uses existing OPENAI_API_KEY and ODDS_API_KEY)
VISION_MODEL=gpt-4.1
VISION_DAILY_LIMIT=30
# Enable Message Content Intent in Discord Developer Portal before setting true.
SCREENSHOT_AUTO_DETECT=false
