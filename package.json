{
  "name": "flea-discord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "news:start": "node src/news-bot.js",
    "news:install": "node src/news-install.js",
    "start": "node --env-file-if-exists=.env src/bot.js",
    "register": "node --env-file-if-exists=.env src/register.js",
    "test": "node --test",
    "check": "node --check src/bot.js && node --check src/providers.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "fast-xml-parser": "5.11.1"
  }
}
